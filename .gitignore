# ==========================================
# Root .gitignore
# ==========================================

# --- Terraform ---
**/.terraform/
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Node / Frontend ---
**/node_modules/
**/dist/
**/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / Backend ---
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# --- Environment & Secret files ---
**/.env.local
**/.env.*.local
*.pem
*.key

# --- OS & IDE ---
.DS_Store
Thumbs.db
*.swp
*.swo
